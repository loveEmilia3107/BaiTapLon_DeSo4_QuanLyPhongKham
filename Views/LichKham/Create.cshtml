@using static QuanLyPhongKham.Models.LichKham
@model QuanLyPhongKham.Models.LichKham

@{
    ViewData["Title"] = "Create";
}

<h1>Create</h1>

<h4>LichKham</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="mmbs" class="control-label"></label>
                <select asp-for="mmbs" class ="form-control" asp-items="ViewBag.mmbs"></select>
            </div>
            <div class="form-group">
                <label asp-for="ngayKham" class="control-label"></label>
                <input asp-for="ngayKham" class="form-control" />
                <span asp-validation-for="ngayKham" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="gioBatdau" class="control-label"></label>
                <input asp-for="gioBatdau" class="form-control" />
                <span asp-validation-for="gioBatdau" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="gioKetthuc" class="control-label"></label>
                <input asp-for="gioKetthuc" class="form-control" />
                <span asp-validation-for="gioKetthuc" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="maxSL" class="control-label"></label>
                <input asp-for="maxSL" class="form-control" />
                <span asp-validation-for="maxSL" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="TrangThaiLK" class="control-label"></label>
                <select asp-for="TrangThaiLK" class="form-control"
                        asp-items="Html.GetEnumSelectList<TrangThaiLichKham>()">
                    <option value="">-- Chọn trạng thái --</option>
                </select>
            </div>
            <div class="form-group">
                <input type="submit" value="Create" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
