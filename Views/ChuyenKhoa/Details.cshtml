@using static QuanLyPhongKham.Models.ChuyenKhoa
@model QuanLyPhongKham.Models.ChuyenKhoa

@{
    ViewData["Title"] = "Chi Tiết Chuyên Khoa";
}

<div class="row justify-content-center my-4">
    <div class="col-md-7 col-lg-6">
        <div class="card shadow-sm border-0 rounded-3 overflow-hidden">
            <div class="card-header bg-primary text-white p-3 text-center">
                <h4 class="mb-0 fw-bold">
                    <i class="bi bi-diagram-3 me-2"></i>Chi Tiết Chuyên Khoa #@Model.maCK
                </h4>
            </div>
            <div class="card-body p-4">
                <div class="row g-3">
                    <div class="col-md-6 border-bottom pb-3">
                        <label class="text-muted small fw-bold d-block text-uppercase">Tên Chuyên Khoa</label>
                        <span class="fs-5 fw-bold text-dark">@Model.tenCK</span>
                    </div>

                    <div class="col-md-6 border-bottom pb-3 text-md-end">
                        <label class="text-muted small fw-bold d-block text-uppercase mb-1">Trạng Thái</label>
                        @if (Model.TrangThaiCK == TrangThaiChuyenKhoa.DangHoatDong)
                        {
                            <span class="badge bg-success rounded-pill px-3 py-2 fs-6">
                                <i class="bi bi-check-circle me-1"></i>Đang hoạt động
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-secondary rounded-pill px-3 py-2 fs-6">
                                <i class="bi bi-pause-circle me-1"></i>Tạm dừng
                            </span>
                        }
                    </div>

                    <div class="col-12 mt-2">
                        <label class="text-muted small fw-bold d-block">MÔ TẢ CHI TIẾT</label>
                        <div class="p-3 bg-light border rounded-3 text-secondary mt-1">
                            @(string.IsNullOrEmpty(Model.motaCK) ? "Chưa có mô tả chi tiết cho chuyên khoa này." :
                            Model.motaCK)
                        </div>
                    </div>
                </div>

                <div class="d-flex justify-content-between align-items-center mt-4 pt-3 border-top">
                    <a asp-action="Index" class="btn btn-outline-secondary fw-semibold">
                        <i class="bi bi-arrow-left me-1"></i> Quay lại
                    </a>
                    <a asp-action="Edit" asp-route-id="@Model.maCK" class="btn btn-primary fw-semibold px-4 shadow-sm">
                        <i class="bi bi-pencil me-1"></i> Chỉnh Sửa
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>