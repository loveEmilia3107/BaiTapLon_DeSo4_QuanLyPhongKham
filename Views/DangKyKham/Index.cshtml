@using Microsoft.AspNetCore.Http
@model IEnumerable<QuanLyPhongKham.Models.DangKyKham>

@{
    ViewData["Title"] = "Lịch Sử Đăng Ký Khám";

    int? currentRole = Context.Session.GetInt32("Role");
    bool isAdmin = currentRole.HasValue && currentRole.Value == 0;
    bool isShowAll = ViewBag.IsShowAll ?? false;
}

<!-- HEADER TRANG -->
<div class="card shadow-sm border-0 mb-4 rounded-3">
    <div class="card-body p-4">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
            <div>
                <h3 class="fw-bold text-primary mb-1">
                    <i class="bi bi-journal-medical me-2"></i>
                    @(isShowAll ? "Quản Lý Đăng Ký Khám (Toàn Hệ Thống)" : "Lịch Sử Đăng Ký Khám Của Tôi")
                </h3>
                <p class="text-muted mb-0">
                    @(isShowAll ? "Toàn bộ danh sách phiếu đăng ký khám bệnh của phòng khám" : "Danh sách các ca đăng ký khám bệnh")
                </p>
            </div>
            <div class="d-flex align-items-center gap-2">
                @if (isAdmin)
                {
                    <div class="btn-group me-2" role="group">
                        <a asp-action="Index" asp-route-all="false"
                           class="btn btn-outline-primary fw-semibold @(!isShowAll ? "active" : "")">
                            <i class="bi bi-person-fill me-1"></i> Của tôi
                        </a>
                        <a asp-action="Index" asp-route-all="true"
                           class="btn btn-outline-primary fw-semibold @(isShowAll ? "active" : "")">
                            <i class="bi bi-globe me-1"></i> Tất cả
                        </a>
                    </div>
                }

                <a asp-controller="LichKham" asp-action="Index" class="btn btn-success fw-semibold shadow-sm">
                    <i class="bi bi-calendar-plus me-1"></i> Đăng Ký Khám Mới
                </a>
            </div>
        </div>
    </div>
</div>

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show my-3 shadow-sm border-0" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2 fs-5"></i> @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show my-3 shadow-sm border-0" role="alert">
        <i class="bi bi-check-circle-fill me-2 fs-5"></i> @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (Model != null && Model.Any())
{
    <div class="card shadow-sm border-0 rounded-3 overflow-hidden">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-primary text-white">
                    <tr>
                        <th class="py-3 px-4">Mã Phiếu & Bệnh Nhân</th>
                        <th class="py-3 px-3">Bác Sĩ & Ngày Khám</th>
                        <th class="py-3 px-3">Ngày Đăng Ký</th>
                        <th class="py-3 px-3">Lý Do Khám</th>
                        <th class="py-3 px-3 text-center">Trạng Thái</th>
                        <th class="py-3 px-4 text-end" style="min-width: 240px;">Thao Tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        bool isCanceled = item.TrangThaiDK == QuanLyPhongKham.Models.DangKyKham.TrangThaiDangKy.DaHuy;
                        bool isCompleted = item.TrangThaiDK == QuanLyPhongKham.Models.DangKyKham.TrangThaiDangKy.DaKham;

                        <tr>
                            <!-- BỆNH NHÂN -->
                            <td class="px-4">
                                <div class="d-flex align-items-center">
                                    <div
                                        class="bg-primary bg-opacity-10 text-primary rounded-circle p-2 me-3 d-none d-sm-block">
                                        <i class="bi bi-receipt fs-4"></i>
                                    </div>
                                    <div>
                                        <div class="fw-bold text-dark fs-6">
                                            @(item.bn01 != null ? item.bn01.tenBN : "N/A")
                                        </div>
                                        <small class="text-muted">Mã phiếu: #@item.maPhieu</small>
                                    </div>
                                </div>
                            </td>

                            <!-- BÁC SĨ & LỊCH KHÁM -->
                            <td class="px-3">
                                @if (item.mLK != null)
                                {
                                    <div class="fw-semibold text-dark">
                                        <i class="bi bi-person-badge text-primary me-1"></i>
                                        BS. @(item.mLK.bs != null ? item.mLK.bs.tenBS : "Chưa phân công")
                                    </div>
                                    <small class="text-muted">
                                        <i class="bi bi-calendar-event me-1"></i>
                                        @item.mLK.ngayKham.ToString("dd/MM/yyyy") (@item.mLK.gioBatdau.ToString(@"HH\:mm") -
                                        @item.mLK.gioKetthuc.ToString(@"HH\:mm"))
                                    </small>
                                }
                                else
                                {
                                    <span class="text-muted">Lịch khám #@item.mlk</span>
                                }
                            </td>

                            <!-- NGÀY ĐĂNG KÝ -->
                            <td class="px-3 text-muted">
                                @item.ngayDK.ToString("dd/MM/yyyy")
                            </td>

                            <!-- LÝ DO KHÁM -->
                            <td class="px-3 text-secondary">
                                @(string.IsNullOrEmpty(item.LiDo) ? "—" : item.LiDo)
                            </td>

                            <!-- TRẠNG THÁI BADGE -->
                            <td class="px-3 text-center">
                                @switch (item.TrangThaiDK)
                                {
                                    case QuanLyPhongKham.Models.DangKyKham.TrangThaiDangKy.ChoXacNhan:
                                        <span class="badge bg-warning text-dark rounded-pill px-3 py-2">
                                            <i class="bi bi-clock-history me-1"></i>Chờ xác nhận
                                        </span>
                                        break;
                                    case QuanLyPhongKham.Models.DangKyKham.TrangThaiDangKy.DaXacNhan:
                                        <span class="badge bg-info text-dark rounded-pill px-3 py-2">
                                            <i class="bi bi-check2-circle me-1"></i>Đã xác nhận
                                        </span>
                                        break;
                                    case QuanLyPhongKham.Models.DangKyKham.TrangThaiDangKy.DaKham:
                                        <span class="badge bg-success rounded-pill px-3 py-2">
                                            <i class="bi bi-check-all me-1"></i>Đã khám xong
                                        </span>
                                        break;
                                    case QuanLyPhongKham.Models.DangKyKham.TrangThaiDangKy.DaHuy:
                                        <span class="badge bg-secondary rounded-pill px-3 py-2">
                                            <i class="bi bi-x-circle me-1"></i>Đã hủy
                                        </span>
                                        break;
                                }
                            </td>

                            <!-- THAO TÁC -->
                            <td class="px-4 text-end">
                                <div class="d-inline-flex gap-1 align-items-center">
                                    <!-- 1. CHI TIẾT -->
                                    <a asp-action="Details" asp-route-id="@item.maPhieu" class="btn btn-sm btn-outline-info"
                                       title="Xem chi tiết">
                                        <i class="bi bi-eye"></i>
                                    </a>

                                    <!-- 2. SỬA (CHO CẢ ADMIN VÀ CHỦ SỞ HỮU) -->
                                    <a asp-action="Edit" asp-route-id="@item.maPhieu" class="btn btn-sm btn-outline-primary"
                                       title="Chỉnh sửa phiếu">
                                        <i class="bi bi-pencil"></i>
                                    </a>

                                    <!-- 3. HỦY ĐƠN NHANH (KHI CHƯA KHÁM & CHƯA HỦY) -->
                                    @if (!isCanceled && !isCompleted)
                                    {
                                        <button type="button" class="btn btn-sm btn-outline-warning text-dark"
                                                data-bs-toggle="modal" data-bs-target="#cancelModal-@item.maPhieu"
                                                title="Hủy đơn đăng ký">
                                            <i class="bi bi-slash-circle"></i> Hủy
                                        </button>

                                        <!-- MODAL XÁC NHẬN HỦY ĐƠN -->
                                        <div class="modal fade" id="cancelModal-@item.maPhieu" tabindex="-1" aria-hidden="true">
                                            <div class="modal-dialog modal-dialog-centered text-start">
                                                <div class="modal-content border-0 shadow">
                                                    <div class="modal-header bg-warning text-dark">
                                                        <h5 class="modal-title fw-bold">
                                                            <i class="bi bi-exclamation-triangle-fill me-2"></i>Xác Nhận Hủy Đăng Ký
                                                        </h5>
                                                        <button type="button" class="btn-close" data-bs-dismiss="modal"
                                                                aria-label="Close"></button>
                                                    </div>
                                                    <div class="modal-body p-4">
                                                        <p class="mb-1 text-dark fs-6">
                                                            Bạn có chắc chắn muốn chuyển phiếu đăng ký mã <strong
                                                            class="text-danger">#@item.maPhieu</strong> sang trạng thái
                                                            <strong>Đã Hủy</strong> không?
                                                        </p>
                                                        <small class="text-muted d-block mt-2">
                                                            <i class="bi bi-info-circle me-1"></i>Lưu ý: Ca khám sẽ được giải phóng
                                                            1 chỗ (slot) lại cho lịch khám.
                                                        </small>
                                                    </div>
                                                    <div class="modal-footer bg-light p-3">
                                                        <button type="button" class="btn btn-secondary fw-semibold"
                                                                data-bs-dismiss="modal">Không, giữ lại</button>

                                                        <form asp-action="HuyDon" asp-route-id="@item.maPhieu" method="post"
                                                              class="d-inline">
                                                            @Html.AntiForgeryToken()
                                                            <button type="submit"
                                                                    class="btn btn-warning fw-semibold px-4 text-dark">
                                                                <i class="bi bi-x-circle me-1"></i> Đồng ý Hủy
                                                            </button>
                                                        </form>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    }

                                    <!-- 4. XÓA TRỰC TIẾP VIA MODAL -->
                                    <button type="button" class="btn btn-sm btn-outline-danger" data-bs-toggle="modal"
                                            data-bs-target="#deleteModal-@item.maPhieu" title="Xóa phiếu đăng ký">
                                        <i class="bi bi-trash"></i>
                                    </button>

                                    <!-- MODAL XÓA TRỰC TIẾP -->
                                    <div class="modal fade" id="deleteModal-@item.maPhieu" tabindex="-1" aria-hidden="true">
                                        <div class="modal-dialog modal-dialog-centered text-start">
                                            <div class="modal-content border-0 shadow">
                                                <div class="modal-header bg-danger text-white">
                                                    <h5 class="modal-title fw-bold">
                                                        <i class="bi bi-exclamation-triangle-fill me-2"></i>Xác Nhận Xóa Phiếu
                                                    </h5>
                                                    <button type="button" class="btn-close btn-close-white"
                                                            data-bs-dismiss="modal" aria-label="Close"></button>
                                                </div>
                                                <div class="modal-body p-4">
                                                    <p class="mb-1 text-dark fs-6">
                                                        Bạn có chắc chắn muốn <strong class="text-danger">XÓA HẲN</strong> phiếu
                                                        đăng ký khám mã <strong class="text-danger">#@item.maPhieu</strong> khỏi
                                                        hệ thống?
                                                    </p>
                                                    <small class="text-muted d-block mt-2">
                                                        <i class="bi bi-info-circle me-1"></i>Hành động này không thể hoàn tác!
                                                    </small>
                                                </div>
                                                <div class="modal-footer bg-light p-3">
                                                    <button type="button" class="btn btn-secondary fw-semibold"
                                                            data-bs-dismiss="modal">Hủy bỏ</button>

                                                    <form asp-action="Delete" asp-route-id="@item.maPhieu" method="post"
                                                          class="d-inline">
                                                        @Html.AntiForgeryToken()
                                                        <button type="submit" class="btn btn-danger fw-semibold px-4">
                                                            <i class="bi bi-trash me-1"></i> Đúng, Xóa Ngay!
                                                        </button>
                                                    </form>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
else
{
    <div class="card shadow-sm border-0 rounded-3 text-center p-5">
        <div class="card-body">
            <i class="bi bi-calendar-x text-muted display-1 mb-3"></i>
            <h4 class="fw-bold text-dark mb-2">Chưa có dữ liệu đăng ký khám!</h4>
            <p class="text-muted">
                @(isShowAll ? "Phòng khám chưa nhận phiếu đăng ký khám nào." : "Tài khoản của bạn chưa thực hiện đăng ký lịch khám nào.")
            </p>
            <a asp-controller="LichKham" asp-action="Index" class="btn btn-primary mt-2 fw-semibold">
                <i class="bi bi-calendar-plus me-1"></i> Xem Lịch Khám Để Đăng Ký
            </a>
        </div>
    </div>
}