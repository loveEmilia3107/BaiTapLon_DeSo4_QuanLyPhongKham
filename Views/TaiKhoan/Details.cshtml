@using Microsoft.AspNetCore.Http
@using static QuanLyPhongKham.Models.TaiKhoan
@model QuanLyPhongKham.Models.TaiKhoan

@{
    ViewData["Title"] = "Chi Tiết Tài Khoản";

    int? currentRole = Context.Session.GetInt32("Role");
    int? currentAccId = Context.Session.GetInt32("AccID");
    
    bool isAdmin = currentRole.HasValue && currentRole.Value == 0;
    bool isMyAccount = currentAccId.HasValue && currentAccId.Value == Model.maTK;
}

<div class="row justify-content-center my-4">
    <div class="col-md-7 col-lg-6">
        <div class="card shadow-sm border-0 rounded-3 overflow-hidden">
            <!-- HEADER CARD -->
            <div class="card-header bg-primary text-white p-3 text-center">
                <h4 class="mb-0 fw-bold">
                    <i class="bi bi-person-badge me-2"></i>Thông Tin Tài Khoản
                </h4>
            </div>

            <!-- CARD BODY -->
            <div class="card-body p-4">
                <div class="row g-3">
                    <!-- TÊN ĐĂNG NHẬP -->
                    <div class="col-md-6 border-bottom pb-3">
                        <label class="text-muted small fw-bold d-block text-uppercase">Tên Đăng Nhập</label>
                        <span class="fs-5 fw-bold text-dark">
                            <i class="bi bi-person-circle text-primary me-1"></i>@Model.username
                        </span>
                    </div>

                    <!-- MẬT KHẨU (SỬ DỤNG TOGGLE XEM MẬT KHẨU) -->
                    <div class="col-md-6 border-bottom pb-3">
                        <label class="text-muted small fw-bold d-block text-uppercase mb-1">Mật Khẩu</label>
                        <div class="input-group input-group-sm" style="max-width: 220px;">
                            <input type="password" id="inputDetailsPassword"
                                   class="form-control bg-light border-secondary border-opacity-25 fw-semibold"
                                   value="@Model.password" readonly />
                            <button class="btn btn-outline-secondary" type="button" id="btnToggleDetailsPassword"
                                    title="Ẩn/Hiện mật khẩu">
                                <i class="bi bi-eye-slash" id="iconEyeDetails"></i>
                            </button>
                        </div>
                    </div>

                    <!-- SỐ ĐIỆN THOẠI -->
                    <div class="col-md-6 border-bottom pb-3">
                        <label class="text-muted small fw-bold d-block text-uppercase">Số Điện Thoại</label>
                        <span class="fs-6 fw-semibold text-dark">
                            <i class="bi bi-telephone me-1 text-success"></i>
                            @(string.IsNullOrEmpty(Model.sdt) ? "Chưa cập nhật" : Model.sdt)
                        </span>
                    </div>

                    <!-- EMAIL -->
                    <div class="col-md-6 border-bottom pb-3">
                        <label class="text-muted small fw-bold d-block text-uppercase">Địa Chỉ Email</label>
                        <span class="fs-6 fw-semibold text-dark">
                            <i class="bi bi-envelope me-1 text-info"></i>
                            @(string.IsNullOrEmpty(Model.email) ? "Chưa cập nhật" : Model.email)
                        </span>
                    </div>

                    <!-- VAI TRÒ (ROLE) -->
                    <div class="col-md-6 border-bottom pb-3">
                        <label class="text-muted small fw-bold d-block text-uppercase mb-1">Vai Trò Hệ Thống</label>
                        @if (Model.role == 0)
                        {
                            <span class="badge bg-danger rounded-pill px-3 py-2 fs-6">
                                <i class="bi bi-shield-lock-fill me-1"></i>Quản trị viên (Admin)
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-primary rounded-pill px-3 py-2 fs-6">
                                <i class="bi bi-person-fill me-1"></i>Bệnh nhân
                            </span>
                        }
                    </div>

                    <!-- TRẠNG THÁI TÀI KHOẢN -->
                    <div class="col-md-6 border-bottom pb-3">
                        <label class="text-muted small fw-bold d-block text-uppercase mb-1">Trạng Thái Tài Khoản</label>
                        @if (Model.TrangThaiTK == TrangThaiTaiKhoan.DangHoatDong)
                        {
                            <span class="badge bg-success rounded-pill px-3 py-2 fs-6">
                                <i class="bi bi-check-circle me-1"></i>Đang hoạt động
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-danger rounded-pill px-3 py-2 fs-6">
                                <i class="bi bi-slash-circle me-1"></i>Bị khóa
                            </span>
                        }
                    </div>
                </div>

                <!-- FOOTER BUTTONS THAO TÁC -->
                <div class="d-flex justify-content-between align-items-center mt-4 pt-3 border-top">
                    <a asp-action="Index" class="btn btn-outline-secondary fw-semibold">
                        <i class="bi bi-arrow-left me-1"></i> Quay lại
                    </a>

                    <div class="d-flex gap-2">
                        @if (isMyAccount)
                        {
                            <a asp-action="DoiMatKhau" class="btn btn-outline-warning text-dark fw-semibold">
                                <i class="bi bi-key me-1"></i> Đổi mật khẩu
                            </a>
                        }

                        @if (isAdmin || isMyAccount)
                        {
                            <a asp-action="Edit" asp-route-id="@Model.maTK"
                               class="btn btn-primary fw-semibold px-3 shadow-sm">
                                <i class="bi bi-pencil me-1"></i> Chỉnh sửa
                            </a>
                        }

                        @if (isAdmin && !isMyAccount)
                        {
                            <!-- NÚT XÓA DÀNH CHO ADMIN XÓA TÀI KHOẢN KHÁC -->
                            <button type="button" class="btn btn-outline-danger fw-semibold" data-bs-toggle="modal"
                                    data-bs-target="#deleteModal-@Model.maTK" title="Xóa tài khoản">
                                <i class="bi bi-trash me-1"></i> Xóa
                            </button>

                            <!-- MODAL XÁC NHẬN XÓA TẠI CHỖ -->
                            <div class="modal fade" id="deleteModal-@Model.maTK" tabindex="-1" aria-hidden="true">
                                <div class="modal-dialog modal-dialog-centered text-start">
                                    <div class="modal-content border-0 shadow">
                                        <div class="modal-header bg-danger text-white">
                                            <h5 class="modal-title fw-bold">
                                                <i class="bi bi-exclamation-triangle-fill me-2"></i>Xác Nhận Xóa Tài Khoản
                                            </h5>
                                            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"
                                                    aria-label="Close"></button>
                                        </div>
                                        <div class="modal-body p-4">
                                            <p class="mb-2 text-dark fs-6">
                                                Bạn có chắc chắn muốn xóa tài khoản <strong
                                                class="text-danger">@Model.username</strong> không?
                                            </p>
                                            <small class="text-muted d-block">
                                                <i class="bi bi-info-circle me-1"></i>Lưu ý: Chỉ xóa được tài khoản khi
                                                không còn dữ liệu Hồ sơ bệnh nhân đang liên kết.
                                            </small>
                                        </div>
                                        <div class="modal-footer bg-light p-3">
                                            <button type="button" class="btn btn-outline-secondary fw-semibold"
                                                    data-bs-dismiss="modal">Hủy bỏ</button>
                                            <form asp-action="Delete" asp-route-id="@Model.maTK" method="post"
                                                  class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-danger fw-bold shadow-sm px-4">
                                                    <i class="bi bi-trash-fill me-1"></i> Đúng, Xóa Ngay!
                                                </button>
                                            </form>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const btnToggle = document.getElementById("btnToggleDetailsPassword");
            const inputPass = document.getElementById("inputDetailsPassword");
            const iconEye = document.getElementById("iconEyeDetails");

            if (btnToggle && inputPass && iconEye) {
                btnToggle.addEventListener("click", function () {
                    const isPassword = inputPass.getAttribute("type") === "password";
                    if (isPassword) {
                        inputPass.setAttribute("type", "text");
                        iconEye.classList.remove("bi-eye-slash");
                        iconEye.classList.add("bi-eye");
                    } else {
                        inputPass.setAttribute("type", "password");
                        iconEye.classList.remove("bi-eye");
                        iconEye.classList.add("bi-eye-slash");
                    }
                });
            }
        });
    </script>
}