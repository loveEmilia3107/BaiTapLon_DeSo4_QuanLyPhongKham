@model QuanLyPhongKham.Models.TaiKhoan

@{
    ViewData["Title"] = "Đăng nhập";
}

<div class="row justify-content-center my-5">
    <div class="col-md-5 col-lg-4">
        <div class="card shadow border-0 rounded-3 overflow-hidden">
            <!-- HEADER -->
            <div class="card-header bg-primary text-white text-center py-3">
                <h4 class="mb-0 fw-bold">
                    <i class="bi bi-box-arrow-in-right me-2"></i>Đăng Nhập Hệ Thống
                </h4>
            </div>

            <!-- CARD BODY -->
            <div class="card-body p-4">
                <form asp-action="Login" method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                    <!-- TÊN ĐĂNG NHẬP -->
                    <div class="mb-3">
                        <label class="form-label fw-bold">Tên đăng nhập</label>
                        <input name="username" class="form-control" placeholder="Nhập tên đăng nhập..." required />
                    </div>

                    <!-- MẬT KHẨU -->
                    <div class="mb-3">
                        <label class="form-label fw-bold">Mật khẩu</label>
                        <input name="password" type="password" class="form-control" placeholder="Nhập mật khẩu..."
                               required />
                    </div>

                    <!-- NÚT SUBMIT -->
                    <button type="submit" class="btn btn-primary w-100 fw-bold py-2 mt-2 shadow-sm">
                        <i class="bi bi-box-arrow-in-right me-1"></i> Đăng Nhập
                    </button>
                </form>

                <!-- 🛑 THÔNG BÁO ĐỎ LÒM BỊ KHÓA TÀI KHOẢN ĐUỔI CỔ Ở DƯỚI CÙNG -->
                @if (ViewBag.LockErrorMessage != null)
                {
                    <div class="alert alert-danger border-2 border-danger mt-4 mb-0 rounded-3 p-3 shadow-sm" role="alert">
                        <div class="d-flex align-items-start">
                            <i class="bi bi-slash-circle-fill fs-3 text-danger me-2 lh-1"></i>
                            <div>
                                <h6 class="fw-bold text-danger mb-1">TÀI KHOẢN BỊ KHÓA!</h6>
                                <p class="small mb-0 text-dark">
                                    @ViewBag.LockErrorMessage
                                </p>
                            </div>
                        </div>
                    </div>
                }
            </div>

            <!-- FOOTER -->
            <div class="card-footer bg-light text-center py-3">
                <span class="text-muted">Chưa có tài khoản? </span>
                <a asp-action="Register" class="fw-bold text-decoration-none text-primary">Đăng ký ngay</a>
            </div>
        </div>
    </div>
</div>