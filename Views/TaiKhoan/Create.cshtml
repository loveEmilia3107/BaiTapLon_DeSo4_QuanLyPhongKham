@using static QuanLyPhongKham.Models.TaiKhoan
@model QuanLyPhongKham.Models.TaiKhoan

@{
    ViewData["Title"] = "Thêm Tài Khoản Mới";
}

<div class="row justify-content-center my-4">
    <div class="col-md-8 col-lg-6">
        <div class="card shadow-sm border-0 rounded-3">
            <div class="card-header bg-primary text-white p-3 text-center">
                <h4 class="mb-0 fw-bold">
                    <i class="bi bi-person-plus-fill me-2"></i>Thêm Tài Khoản Hệ Thống
                </h4>
            </div>

            <div class="card-body p-4">
                <form asp-action="Create" method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                    <!-- TÊN ĐĂNG NHẬP -->
                    <div class="mb-3">
                        <label asp-for="username" class="form-label fw-bold">Tên Đăng Nhập <span
                            class="text-danger">*</span></label>
                            <input asp-for="username" class="form-control border-primary"
                                   placeholder="Nhập tên đăng nhập..." required />
                            <span asp-validation-for="username" class="text-danger"></span>
                        </div>

                        <!-- MẬT KHẨU KÈM NÚT AN/HIEN -->
                        <div class="mb-3">
                            <label asp-for="password" class="form-label fw-bold">Mật Khẩu <span
                                class="text-danger">*</span></label>
                                <div class="input-group">
                                    <input asp-for="password" type="password" id="inputCreatePassword"
                                           class="form-control border-primary" placeholder="Nhập mật khẩu khởi tạo..." required />
                                    <button class="btn btn-outline-secondary" type="button" id="btnToggleCreatePassword"
                                            title="Ẩn/Hiện mật khẩu">
                                        <i class="bi bi-eye-slash" id="iconEyeCreate"></i>
                                    </button>
                                </div>
                                <span asp-validation-for="password" class="text-danger"></span>
                            </div>

                            <!-- SỐ ĐIỆN THOẠI VÀ EMAIL -->
                            <div class="row g-3 mb-3">
                                <div class="col-md-6">
                                    <label asp-for="sdt" class="form-label fw-bold">Số Điện Thoại</label>
                                    <input asp-for="sdt" class="form-control" placeholder="09xxxx..." />
                                    <span asp-validation-for="sdt" class="text-danger"></span>
                                </div>
                                <div class="col-md-6">
                                    <label asp-for="email" class="form-label fw-bold">Địa Chỉ Email</label>
                                    <input asp-for="email" type="email" class="form-control" placeholder="example@gmail.com" />
                                    <span asp-validation-for="email" class="text-danger"></span>
                                </div>
                            </div>

                            <!-- PHÂN QUYỀN VÀ TRẠNG THÁI -->
                            <div class="row g-3 mb-4">
                                <div class="col-md-6">
                                    <label asp-for="role" class="form-label fw-bold">Phân Quyền (Role) <span
                                        class="text-danger">*</span></label>
                                        <select asp-for="role" class="form-select border-primary fw-semibold" required>
                                            <option value="1">Bệnh nhân (Role = 1)</option>
                                            <option value="0">Quản trị viên (Role = 0)</option>
                                        </select>
                                        <span asp-validation-for="role" class="text-danger"></span>
                                    </div>
                                    <div class="col-md-6">
                                        <label asp-for="TrangThaiTK" class="form-label fw-bold">Trạng Thái Tài Khoản <span
                                            class="text-danger">*</span></label>
                                            <select asp-for="TrangThaiTK" class="form-select border-primary fw-semibold"
                                                    asp-items="Html.GetEnumSelectList<TrangThaiTaiKhoan>()" required>
                                            </select>
                                            <span asp-validation-for="TrangThaiTK" class="text-danger"></span>
                                        </div>
                                    </div>

                                    <!-- NÚT THAO TÁC -->
                                    <div class="d-flex justify-content-between align-items-center pt-2 border-top">
                                        <a asp-action="Index" asp-route-all="true" class="btn btn-outline-secondary fw-semibold">
                                            <i class="bi bi-arrow-left me-1"></i> Quay lại
                                        </a>
                                        <button type="submit" class="btn btn-primary fw-semibold px-4 shadow-sm">
                                            <i class="bi bi-check-circle me-1"></i> Tạo Tài Khoản
                                        </button>
                                    </div>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>

                @section Scripts {
                    @{
                        await Html.RenderPartialAsync("_ValidationScriptsPartial");
                    }
                    <script>
                        document.addEventListener("DOMContentLoaded", function () {
                            const btnToggle = document.getElementById("btnToggleCreatePassword");
                            const inputPass = document.getElementById("inputCreatePassword");
                            const iconEye = document.getElementById("iconEyeCreate");

                            if (btnToggle && inputPass && iconEye) {
                                btnToggle.addEventListener("click", function () {
                                    const isPassword = inputPass.getAttribute("type") === "password";
                                    if (isPassword) {
                                        inputPass.setAttribute("type", "text");
                                        iconEye.classList.remove("bi-eye-slash");
                                        iconEye.classList.add("bi-eye");
                                    } else {
                                        inputPass.setAttribute("type", "password");
                                        iconEye.classList.remove("bi-eye");
                                        iconEye.classList.add("bi-eye-slash");
                                    }
                                });
                            }
                        });
                    </script>
                }