@using Microsoft.AspNetCore.Http
@using static QuanLyPhongKham.Models.TaiKhoan
@model IEnumerable<QuanLyPhongKham.Models.TaiKhoan>

@{
    ViewData["Title"] = "Quản Lý Tài Khoản";

    int? currentRole = Context.Session.GetInt32("Role");
    bool isAdmin = currentRole.HasValue && currentRole.Value == 0;
    bool isShowAll = ViewBag.IsShowAll ?? false;

    var myAccount = Model.FirstOrDefault();
}

<div class="container my-4">
    <!-- THÔNG BÁO TEMP DATA -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm mb-3" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show border-0 shadow-sm mb-3" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- 🛑 TOGGLE SWITCH DÀNH RIÊNG CHO ADMIN -->
    @if (isAdmin)
    {
        <div
            class="alert alert-info d-flex justify-content-between align-items-center mb-4 p-3 rounded-3 border-0 shadow-sm">
            <div>
                <i class="bi bi-shield-lock-fill fs-5 me-2 text-info"></i>
                <strong class="text-dark">Chế độ góc nhìn Admin:</strong>
                <span class="text-muted small ms-1">
                    @(isShowAll ? "Đang hiển thị TOÀN BỘ tài khoản hệ thống (Dạng Bảng List)" : "Đang hiển thị Thông tin Hồ sơ Cá nhân (Dạng Detail)")
                </span>
            </div>
            <div class="form-check form-switch m-0">
                <input class="form-check-input" type="checkbox" id="toggleShowAllAcc" @(isShowAll ? "checked" : "")
                       onchange="location.href='@Url.Action("Index", "TaiKhoan")?all=' + this.checked" />
                <label class="form-check-label fw-bold text-primary ms-1" for="toggleShowAllAcc">
                    Xem tất cả tài khoản
                </label>
            </div>
        </div>
    }

    @if (!isShowAll)
    {
        <!-- ========================================================================= -->
        <!-- 🔴 GÓC NHÌN 1: MẶC ĐỊNH (CÁ NHÂN) - HIỂN THỊ DẠNG HỒ SƠ CARD PROFILE      -->
        <!-- ========================================================================= -->
        <div class="row justify-content-center">
            <div class="col-md-8 col-lg-7">
                <div class="card shadow-sm border-0 rounded-3 overflow-hidden">
                    <div class="card-header bg-primary text-white p-3 text-center">
                        <h4 class="mb-0 fw-bold">
                            <i class="bi bi-person-badge-fill me-2"></i>Thông Tin Tài Khoản Cá Nhân
                        </h4>
                    </div>
                    <div class="card-body p-4">
                        @if (myAccount != null)
                        {
                            <div class="row g-3">
                                <!-- MÃ TÀI KHOẢN -->
                                <div class="col-md-6 border-bottom pb-3">
                                    <label class="text-muted small fw-bold d-block text-uppercase">Mã Tài Khoản</label>
                                    <span class="fs-5 fw-bold text-secondary">#@myAccount.maTK</span>
                                </div>

                                <!-- TÊN ĐĂNG NHẬP -->
                                <div class="col-md-6 border-bottom pb-3">
                                    <label class="text-muted small fw-bold d-block text-uppercase">Tên Đăng Nhập</label>
                                    <span class="fs-5 fw-bold text-dark">
                                        <i class="bi bi-person-circle text-primary me-1"></i>@myAccount.username
                                    </span>
                                </div>

                                <!-- MẬT KHẨU -->
                                <!-- MẬT KHẨU (CÓ NÚT CON MẮT ẨN/HIỆN, DEFAULT LÀ ẨN) -->
                                <div class="col-md-6 border-bottom pb-3">
                                    <label class="text-muted small fw-bold d-block text-uppercase">Mật Khẩu</label>
                                    <div class="d-flex align-items-center gap-2">
                                        <span class="fs-6 fw-semibold text-dark font-monospace">
                                            <i class="bi bi-key me-1 text-warning"></i>
                                            <span id="pwdText" data-password="@myAccount.password">•••••</span>
                                        </span>
                                        <button type="button" class="btn btn-sm btn-link text-secondary p-0 border-0 ms-1"
                                                id="btnTogglePwd" title="Ẩn/Hiện mật khẩu">
                                            <i class="bi bi-eye-slash fs-6" id="eyeIcon"></i>
                                        </button>
                                    </div>
                                </div>

                                <!-- PHÂN QUYỀN -->
                                <div class="col-md-6 border-bottom pb-3">
                                    <label class="text-muted small fw-bold d-block text-uppercase">Vai trò của tài khoản</label>
                                    @if (myAccount.role == 0)
                                    {
                                        <span class="badge bg-danger rounded-pill px-3 py-2 fs-6">
                                            <i class="bi bi-shield-check me-1"></i>Quản trị viên (Admin)
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success rounded-pill px-3 py-2 fs-6">
                                            <i class="bi bi-person me-1"></i>Bệnh nhân
                                        </span>
                                    }
                                </div>

                                <!-- SỐ ĐIỆN THOẠI -->
                                <div class="col-md-6 border-bottom pb-3">
                                    <label class="text-muted small fw-bold d-block text-uppercase">Số Điện Thoại</label>
                                    <span class="fs-6 fw-semibold text-dark">
                                        <i class="bi bi-telephone me-1 text-success"></i>
                                        @(string.IsNullOrEmpty(myAccount.sdt) ? "Chưa cập nhật" : myAccount.sdt)
                                    </span>
                                </div>

                                <!-- EMAIL -->
                                <div class="col-md-6 border-bottom pb-3">
                                    <label class="text-muted small fw-bold d-block text-uppercase">Địa Chỉ Email</label>
                                    <span class="fs-6 fw-semibold text-dark">
                                        <i class="bi bi-envelope me-1 text-info"></i>
                                        @(string.IsNullOrEmpty(myAccount.email) ? "Chưa cập nhật" : myAccount.email)
                                    </span>
                                </div>

                                <!-- TRẠNG THÁI TÀI KHOẢN -->
                                <div class="col-md-12">
                                    <label class="text-muted small fw-bold d-block text-uppercase mb-1">Trạng Thái Hoạt
                                        Động</label>
                                        @if (myAccount.TrangThaiTK == TrangThaiTaiKhoan.DangHoatDong)
                                        {
                                            <span
                                                class="badge bg-success-subtle text-success border border-success px-3 py-2 rounded-pill fs-6">
                                                <i class="bi bi-check-circle me-1"></i>Đang hoạt động bình thường
                                            </span>
                                        }
                                        else
                                        {
                                            <span
                                                class="badge bg-danger-subtle text-danger border border-danger px-3 py-2 rounded-pill fs-6">
                                                <i class="bi bi-x-circle me-1"></i>Tài khoản bị khóa
                                            </span>
                                        }
                                    </div>
                                </div>

                                <!-- BUTTON EDIT & NÚT XÓA TÀI KHOẢN CÁ NHÂN Ở GÓC DƯỚI -->
                                <div class="d-flex justify-content-between align-items-center mt-4 pt-3 border-top">
                                    <!-- 🛑 KHU VỰC NGUY HIỂM: OPTION XÓA TÀI KHOẢN CÁ NHÂN TẠI GÓC DƯỚI BÊN TRÁI -->
                                    <button type="button" class="btn btn-outline-danger btn-sm fw-semibold" data-bs-toggle="modal"
                                            data-bs-target="#deleteSelfModal">
                                        <i class="bi bi-trash3-fill me-1"></i> Xóa tài khoản của tôi
                                    </button>

                                    <a asp-action="DoiMatKhau" class="btn btn-outline-warning fw-semibold me-2">
                                        <i class="bi bi-key me-1"></i> Đổi Mật Khẩu
                                    </a>

                                    <a asp-action="Edit" asp-route-id="@myAccount.maTK"
                                       class="btn btn-primary fw-semibold px-4 shadow-sm">
                                        <i class="bi bi-pencil me-1"></i> Chỉnh Sửa Thông Tin
                                    </a>
                                </div>

                                <!-- 🛑 MODAL CONFIRM XÓA TÀI KHOẢN CÁ NHÂN -->
                                <div class="modal fade" id="deleteSelfModal" tabindex="-1" aria-hidden="true">
                                    <div class="modal-dialog modal-dialog-centered">
                                        <div class="modal-content border-0 shadow">
                                            <div class="modal-header bg-danger text-white">
                                                <h5 class="modal-title fw-bold">
                                                    <i class="bi bi-exclamation-triangle-fill me-2"></i>Xác Nhận Xóa Tài Khoản Cá
                                                    Nhân
                                                </h5>
                                                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"
                                                        aria-label="Close"></button>
                                            </div>
                                            <div class="modal-body text-start text-dark p-4">
                                                <p class="mb-2 fs-6">
                                                    Bạn có chắc chắn muốn xóa vĩnh viễn tài khoản <strong
                                                    class="text-danger">@myAccount.username</strong> khỏi hệ thống?
                                                </p>
                                                <div class="alert alert-warning mb-0 p-3 small rounded-3">
                                                    <i class="bi bi-info-circle-fill me-1"></i>
                                                    <strong>Cảnh báo:</strong> Thao tác này sẽ hủy bỏ toàn bộ quyền truy cập của bạn
                                                    và đăng xuất khỏi hệ thống ngay lập tức! (Yêu cầu tài khoản không còn hồ sơ bệnh
                                                    nhân).
                                                </div>
                                            </div>
                                            <div class="modal-footer bg-light">
                                                <button type="button" class="btn btn-outline-secondary fw-semibold"
                                                        data-bs-dismiss="modal">
                                                    <i class="bi bi-x-circle me-1"></i> Hủy Bỏ
                                                </button>
                                                <form asp-action="DeleteSelf" method="post" class="d-inline">
                                                    @Html.AntiForgeryToken()
                                                    <button type="submit" class="btn btn-danger fw-bold shadow-sm px-3">
                                                        <i class="bi bi-trash-fill me-1"></i> Đồng Ý Xóa Tài Khoản
                                                    </button>
                                                </form>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }
                        else
                            {
                                <div class="text-center text-muted py-4">Không tìm thấy thông tin tài khoản!</div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }
    else
        {
            <!-- ========================================================================= -->
            <!-- 🔵 GÓC NHÌN 2: MODE ALL (QUẢN LÝ ADMIN) - HIỂN THỊ DẠNG BẢNG DANH SÁCH   -->
            <!-- ========================================================================= -->
            <div class="card shadow-sm border-0 rounded-3">
                <div class="card-header bg-primary text-white p-3 d-flex justify-content-between align-items-center">
                    <h4 class="mb-0 fw-bold">
                        <i class="bi bi-people-fill me-2"></i>Quản Lý Tất Cả Tài Khoản Hệ Thống
                    </h4>
                    <a asp-action="Create" class="btn btn-light fw-bold text-primary shadow-sm">
                        <i class="bi bi-plus-circle me-1"></i>Tạo Tài Khoản Mới
                    </a>
                </div>

                <div class="card-body p-4">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle border">
                            <thead class="table-light text-secondary">
                                <tr>
                                    <th class="text-center">Mã TK</th>
                                    <th>Tên Đăng Nhập</th>
                                    <th>Mật Khẩu</th>
                                    <th>Số Điện Thoại</th>
                                    <th>Email</th>
                                    <th class="text-center">Phân Quyền</th>
                                    <th class="text-center">Trạng Thái</th>
                                    <th class="text-center" style="min-width: 150px;">Thao Tác</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (!Model.Any())
                                {
                                    <tr>
                                        <td colspan="8" class="text-center text-muted py-4">
                                            Không tìm thấy dữ liệu tài khoản nào!
                                        </td>
                                    </tr>
                                }
                                else
                                {
                                    @foreach (var item in Model)
                                    {
                                        <tr>
                                            <td class="text-center fw-bold text-secondary">#@item.maTK</td>
                                            <td>
                                                <span class="fw-bold text-dark">
                                                    <i class="bi bi-person-circle me-1 text-primary"></i>
                                                    @item.username
                                                </span>
                                            </td>
                                            <td class="font-monospace text-muted">@item.password</td>
                                            <td>@(string.IsNullOrEmpty(item.sdt) ? "-" : item.sdt)</td>
                                            <td>@(string.IsNullOrEmpty(item.email) ? "-" : item.email)</td>
                                            <td class="text-center">
                                                @if (item.role == 0)
                                                {
                                                    <span class="badge bg-danger rounded-pill px-3 py-1">
                                                        <i class="bi bi-shield-check me-1"></i>Admin
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-success rounded-pill px-3 py-1">
                                                        <i class="bi bi-person me-1"></i>Bệnh nhân
                                                    </span>
                                                }
                                            </td>
                                            <td class="text-center">
                                                @if (item.TrangThaiTK == TrangThaiTaiKhoan.DangHoatDong)
                                                {
                                                    <span
                                                        class="badge bg-success-subtle text-success border border-success px-3 py-1 rounded-pill">
                                                        Đang hoạt động
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span
                                                        class="badge bg-danger-subtle text-danger border border-danger px-3 py-1 rounded-pill">
                                                        Bị khóa
                                                    </span>
                                                }
                                            </td>
                                            <td class="text-center">
                                                <div class="btn-group" role="group">
                                                    <a asp-action="Details" asp-route-id="@item.maTK"
                                                       class="btn btn-sm btn-outline-info" title="Xem chi tiết">
                                                        <i class="bi bi-eye"></i>
                                                    </a>
                                                    <a asp-action="Edit" asp-route-id="@item.maTK"
                                                       class="btn btn-sm btn-outline-primary" title="Chỉnh sửa">
                                                        <i class="bi bi-pencil"></i>
                                                    </a>

                                                    @if (isAdmin && item.maTK != Context.Session.GetInt32("AccID"))
                                                    {
                                                        <!-- NÚT XÓA MỞ MODAL CHO ADMIN -->
                                                        <button type="button" class="btn btn-sm btn-outline-danger" data-bs-toggle="modal"
                                                                data-bs-target="#deleteModal-@item.maTK" title="Xóa tài khoản">
                                                            <i class="bi bi-trash"></i>
                                                        </button>

                                                        <!-- MODAL CONFIRM DELETE DÀNH RIÊNG CHO MỖI TÀI KHOẢN -->
                                                        <div class="modal fade" id="deleteModal-@item.maTK" tabindex="-1"
                                                             aria-hidden="true">
                                                            <div class="modal-dialog modal-dialog-centered">
                                                                <div class="modal-content border-0 shadow">
                                                                    <div class="modal-header bg-danger text-white">
                                                                        <h5 class="modal-title fw-bold">
                                                                            <i class="bi bi-exclamation-octagon-fill me-2"></i>Xác Nhận Xóa
                                                                            Tài Khoản
                                                                        </h5>
                                                                        <button type="button" class="btn-close btn-close-white"
                                                                                data-bs-dismiss="modal" aria-label="Close"></button>
                                                                    </div>
                                                                    <div class="modal-body text-start text-dark p-4">
                                                                        <p class="mb-2">Bạn có chắc chắn muốn xóa tài khoản <strong
                                                                            class="text-danger">@item.username</strong> (Mã #@item.maTK)
                                                                            khỏi hệ thống không?</p>
                                                                            <div class="alert alert-warning mb-0 p-2 small">
                                                                                <i class="bi bi-info-circle me-1"></i>Hành động này không thể
                                                                                hoàn tác! Cần đảm bảo tài khoản không còn liên kết hồ sơ Bệnh
                                                                                nhân.
                                                                            </div>
                                                                        </div>
                                                                        <div class="modal-footer bg-light">
                                                                            <button type="button" class="btn btn-outline-secondary fw-semibold"
                                                                                    data-bs-dismiss="modal">
                                                                                <i class="bi bi-x-circle me-1"></i> Hủy
                                                                            </button>
                                                                            <form asp-action="Delete" asp-route-id="@item.maTK" method="post"
                                                                                  class="d-inline">
                                                                                @Html.AntiForgeryToken()
                                                                                <button type="submit" class="btn btn-danger fw-bold shadow-sm">
                                                                                    <i class="bi bi-trash-fill me-1"></i> Đồng Ý Xóa
                                                                                </button>
                                                                            </form>
                                                                        </div>
                                                                    </div>
                                                                </div>
                                                            </div>
                                                        }
                                                    </div>
                                                </td>
                                            </tr>
                                        }
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            }
        </div>
        @section Scripts {
            <script>
                document.addEventListener("DOMContentLoaded", function () {
                    const btnTogglePwd = document.getElementById("btnTogglePwd");
                    const pwdText = document.getElementById("pwdText");
                    const eyeIcon = document.getElementById("eyeIcon");

                    if (btnTogglePwd && pwdText && eyeIcon) {
                        let isHidden = true;
                        const rawPassword = pwdText.getAttribute("data-password");

                        btnTogglePwd.addEventListener("click", function () {
                            if (isHidden) {
                                pwdText.textContent = rawPassword;
                                eyeIcon.classList.remove("bi-eye-slash");
                                eyeIcon.classList.add("bi-eye");
                            } else {
                                pwdText.textContent = "•••••";
                                eyeIcon.classList.remove("bi-eye");
                                eyeIcon.classList.add("bi-eye-slash");
                            }
                            isHidden = !isHidden;
                        });
                    }
                });
            </script>
        }