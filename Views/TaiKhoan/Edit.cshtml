@using Microsoft.AspNetCore.Http
@using static QuanLyPhongKham.Models.TaiKhoan
@model QuanLyPhongKham.Models.TaiKhoan

@{
    ViewData["Title"] = "Cập Nhật Tài Khoản";

    int? currentRole = Context.Session.GetInt32("Role");
    bool isAdmin = currentRole.HasValue && currentRole.Value == 0;
}

<div class="row justify-content-center my-4">
    <div class="col-md-8 col-lg-7">
        <div class="card shadow-sm border-0 rounded-3">
            <!-- HEADER -->
            <div class="card-header bg-primary text-white p-3 text-center">
                <h4 class="mb-0 fw-bold">
                    <i class="bi bi-pencil-square me-2"></i>Cập Nhật Thông Tin Tài Khoản 
                </h4>
            </div>

            <!-- FORM BODY -->
            <div class="card-body p-4">
                <form asp-action="Edit">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
                    <input type="hidden" asp-for="maTK" />

                    <div class="row g-3">
                        <!-- TÊN ĐĂNG NHẬP -->
                        <div class="col-md-6">
                            <label asp-for="username" class="form-label fw-bold">
                                Tên Đăng Nhập <span class="text-danger">*</span>
                            </label>
                            <input asp-for="username" class="form-control" placeholder="Nhập tên đăng nhập..."
                                   required />
                            <span asp-validation-for="username" class="text-danger"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="password" class="form-label fw-bold">Mật Khẩu</label>
                            @if (isAdmin)
                            {
                                <div class="input-group">
                                    <input asp-for="password" type="password" id="inputPassword"
                                           class="form-control border-primary" placeholder="Nhập mật khẩu..." required />
                                    <button class="btn btn-outline-secondary" type="button" id="btnTogglePassword"
                                            title="Ẩn/Hiện mật khẩu">
                                        <i class="bi bi-eye-slash" id="iconEye"></i>
                                    </button>
                                </div>
                                <small class="text-muted"><i class="bi bi-shield-check text-primary me-1"></i>Chế độ Admin:
                                    Cho phép sửa trực tiếp mật khẩu.</small>
                                }
                            else
                                {
                                    <input asp-for="password" value="Mật khẩu sẽ không được sửa ở đây!" type="text" class="form-control bg-light" readonly
                                           style="pointer-events: none;" />
                                    <small class="text-muted">
                                        <a asp-action="DoiMatKhau" class="text-primary text-decoration-none fw-semibold">
                                            <i class="bi bi-key me-1"></i>Nhấn vào đây để đổi mật khẩu
                                        </a>
                                    </small>
                                }
                                <span asp-validation-for="password" class="text-danger"></span>
                            </div>

                            <!-- SỐ ĐIỆN THOẠI -->
                            <div class="col-md-6">
                                <label asp-for="sdt" class="form-label fw-bold">Số Điện Thoại</label>
                                <input asp-for="sdt" class="form-control" placeholder="Nhập số điện thoại..." />
                                <span asp-validation-for="sdt" class="text-danger"></span>
                            </div>

                            <!-- EMAIL -->
                            <div class="col-md-6">
                                <label asp-for="email" class="form-label fw-bold">Địa Chỉ Email</label>
                                <input asp-for="email" type="email" class="form-control" placeholder="example@email.com" />
                                <span asp-validation-for="email" class="text-danger"></span>
                            </div>

                            <!-- 🛑 PHÂN QUYỀN & TRẠNG THÁI TÀI KHOẢN (CHỈ ADMIN MỚI NHÌN THẤY VÀ THAO TÁC) -->
                            @if (isAdmin)
                            {
                                <!-- PHÂN QUYỀN (ROLE) -->
                                <div class="col-md-6">
                                    <label asp-for="role" class="form-label fw-bold">Phân Quyền Vai Trò</label>
                                    <select asp-for="role" class="form-select border-primary fw-semibold">
                                        <option value="1">Bệnh nhân (Role = 1)</option>
                                        <option value="0">Quản trị viên (Role = 0)</option>
                                    </select>
                                    <span asp-validation-for="role" class="text-danger"></span>
                                </div>

                                <!-- TRẠNG THÁI TÀI KHOẢN -->
                                <div class="col-md-6">
                                    <label asp-for="TrangThaiTK" class="form-label fw-bold">Trạng Thái Tài Khoản</label>
                                    <select asp-for="TrangThaiTK" class="form-select border-primary fw-semibold"
                                            asp-items="Html.GetEnumSelectList<TrangThaiTaiKhoan>()">
                                    </select>
                                    <span asp-validation-for="TrangThaiTK" class="text-danger"></span>
                                </div>
                            }
                            else
                            {
                                <!-- BỆNH NHÂN THƯỜNG: ẨN SẠCH UI, GIỮ LẠI INPUT HIDDEN ĐỂ SUBMIT FORM KHÔNG BỊ MẤT GIÁ TRỊ -->
                                <input type="hidden" asp-for="role" />
                                <input type="hidden" asp-for="TrangThaiTK" />
                            }

                            <!-- BUTTONS -->
                            <div class="d-flex justify-content-between align-items-center mt-4 pt-3 border-top">
                                <a asp-action="Index" class="btn btn-outline-secondary fw-semibold">
                                    <i class="bi bi-arrow-left me-1"></i> Quay lại
                                </a>
                                <button type="submit" class="btn btn-primary fw-semibold px-4 shadow-sm">
                                    <i class="bi bi-check-circle me-1"></i> Lưu Cập Nhật
                                </button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>

        @section Scripts {
            @{
                await Html.RenderPartialAsync("_ValidationScriptsPartial");
            }

            <!-- SCRIPT TOGGLE CON MẮT MẬT KHẨU DÀNH CHO ADMIN -->
            <script>
                document.addEventListener("DOMContentLoaded", function () {
                    const btnTogglePassword = document.getElementById("btnTogglePassword");
                    const inputPassword = document.getElementById("inputPassword");
                    const iconEye = document.getElementById("iconEye");

                    if (btnTogglePassword && inputPassword && iconEye) {
                        btnTogglePassword.addEventListener("click", function () {
                            const isPassword = inputPassword.getAttribute("type") === "password";
                    
                            if (isPassword) {
                                inputPassword.setAttribute("type", "text");
                                iconEye.classList.remove("bi-eye-slash");
                                iconEye.classList.add("bi-eye");
                            } else {
                                inputPassword.setAttribute("type", "password");
                                iconEye.classList.remove("bi-eye");
                                iconEye.classList.add("bi-eye-slash");
                            }
                        });
                    }
                });
            </script>
        }