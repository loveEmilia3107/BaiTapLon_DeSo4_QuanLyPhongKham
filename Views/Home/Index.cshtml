@using Microsoft.AspNetCore.Http
@using static QuanLyPhongKham.Models.BacSi
@model IEnumerable<QuanLyPhongKham.Models.BacSi>

@{
    ViewData["Title"] = "Trang chủ Dashboard";
    int? currentAccId = Context.Session.GetInt32("AccID");
    int? currentRole = Context.Session.GetInt32("Role");
    bool isAdmin = currentRole.HasValue && currentRole.Value == 0;
    string username = Context.Session.GetString("Username") ?? "Bạn";
    bool isLoggedIn = currentAccId.HasValue && currentAccId.Value > 0;
}

<div class="container my-4">
    @if (isAdmin)
    {
        <div class="card bg-primary text-white mb-4 border-0 shadow-sm rounded-3 overflow-hidden">
            <div class="card-body p-4 p-lg-5 position-relative">
                <div class="row align-items-center">
                    <div class="col-md-8">
                        <span class="badge bg-white text-primary fw-bold px-3 py-2 mb-2 rounded-pill">
                            <i class="bi bi-shield-check me-1"></i> Bảng Điều Khiển Admin
                        </span>
                        <h1 class="fw-bold mb-2">Xin chào Quản trị viên, @username!</h1>
                        <p class="lead mb-0 opacity-75">
                            Bài Tập Lớn Quản Lý Phòng Khám, quản lý bệnh nhân, bác sĩ, chuyên khoa và lịch khám!
                        </p>
                    </div>
                    
                    <div class="col-md-4 text-center d-none d-md-block">
                        <img src="~/images/a.jpg" alt="Admin Banner" class="img-fluid rounded-3 shadow"
                             style="max-height: 140px; object-fit: cover;"
                             onerror="this.src='https://via.placeholder.com/300x140?text=CHÈN+ẢNH+TẠI+ĐÂY'" />
                    </div>
                </div>
            </div>
        </div>

        <div class="row g-3 mb-4">
            <div class="col-md-3">
                <div class="card border-0 shadow-sm h-100 border-start border-primary border-4">
                    <div class="card-body d-flex align-items-center">
                        <div class="rounded-circle bg-primary bg-opacity-10 p-3 me-3 text-primary">
                            <i class="bi bi-person-badge fs-2"></i>
                        </div>
                        <div>
                            <h6 class="text-muted fw-normal mb-1">Tổng Bác Sĩ</h6>
                            <h3 class="fw-bold mb-0">@(ViewBag.SoLuongBacSi ?? 0)</h3>
                        </div>
                    </div>
                    <div class="card-footer bg-transparent border-0 pt-0 text-end">
                        <a asp-controller="BacSi" asp-action="Index" class="text-decoration-none small fw-semibold">
                            Quản lý bác sĩ <i class="bi bi-arrow-right"></i>
                        </a>
                    </div>
                </div>
            </div>

            <div class="col-md-3">
                <div class="card border-0 shadow-sm h-100 border-start border-success border-4">
                    <div class="card-body d-flex align-items-center">
                        <div class="rounded-circle bg-success bg-opacity-10 p-3 me-3 text-success">
                            <i class="bi bi-diagram-3 fs-2"></i>
                        </div>
                        <div>
                            <h6 class="text-muted fw-normal mb-1">Chuyên Khoa</h6>
                            <h3 class="fw-bold mb-0">@(ViewBag.SoLuongChuyenKhoa ?? 0)</h3>
                        </div>
                    </div>
                    <div class="card-footer bg-transparent border-0 pt-0 text-end">
                        <a asp-controller="ChuyenKhoa" asp-action="Index"
                           class="text-decoration-none small text-success fw-semibold">
                            Quản lý khoa <i class="bi bi-arrow-right"></i>
                        </a>
                    </div>
                </div>
            </div>

            <div class="col-md-3">
                <div class="card border-0 shadow-sm h-100 border-start border-info border-4">
                    <div class="card-body d-flex align-items-center">
                        <div class="rounded-circle bg-info bg-opacity-10 p-3 me-3 text-info">
                            <i class="bi bi-people fs-2"></i>
                        </div>
                        <div>
                            <h6 class="text-muted fw-normal mb-1">Bệnh Nhân</h6>
                            <h3 class="fw-bold mb-0">@(ViewBag.SoLuongBenhNhan ?? 0)</h3>
                        </div>
                    </div>
                    <div class="card-footer bg-transparent border-0 pt-0 text-end">
                        <a asp-controller="BenhNhan" asp-action="Index" asp-route-all="true"
                           class="text-decoration-none small text-info fw-semibold">
                            Xem toàn bộ BN <i class="bi bi-arrow-right"></i>
                        </a>
                    </div>
                </div>
            </div>

            <div class="col-md-3">
                <div class="card border-0 shadow-sm h-100 border-start border-warning border-4">
                    <div class="card-body d-flex align-items-center">
                        <div class="rounded-circle bg-warning bg-opacity-10 p-3 me-3 text-warning">
                            <i class="bi bi-journal-check fs-2"></i>
                        </div>
                        <div>
                            <h6 class="text-muted fw-normal mb-1">Phiếu Đăng Ký</h6>
                            <h3 class="fw-bold mb-0">@(ViewBag.SoLuongDangKyKham ?? 0)</h3>
                        </div>
                    </div>
                    <div class="card-footer bg-transparent border-0 pt-0 text-end">
                        <a asp-controller="DangKyKham" asp-action="Index"
                           class="text-decoration-none small text-warning fw-semibold">
                            Duyệt lịch khám <i class="bi bi-arrow-right"></i>
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <div class="row g-4">
            <div class="col-lg-8">
                <div class="card border-0 shadow-sm rounded-3">
                    <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center border-0">
                        <h5 class="fw-bold mb-0 text-primary">
                            <i class="bi bi-person-badge-fill me-2"></i>Danh Sách Bác Sĩ Hệ Thống
                        </h5>
                        <a asp-controller="BacSi" asp-action="Create" class="btn btn-sm btn-primary fw-semibold">
                            <i class="bi bi-plus-lg me-1"></i>Thêm Bác Sĩ
                        </a>
                    </div>
                    <div class="card-body p-0">
                        @if (Model != null && Model.Any())
                        {
                            <div class="table-responsive">
                                <table class="table table-hover align-middle mb-0">
                                    <thead class="table-light">
                                        <tr>
                                            <th class="ps-3">Họ và Tên</th>
                                            <th>Chuyên Khoa</th>
                                            <th>Kinh Nghiệm</th>
                                            <th>Giá Khám</th>
                                            <th class="text-center">Trạng Thái</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var bs in Model)
                                        {
                                            <tr>
                                                <td class="ps-3 fw-bold text-dark">BS. @bs.tenBS</td>
                                                <td>
                                                    <span class="badge bg-info-subtle text-info border border-info">
                                                        @(bs.mCK?.tenCK ?? "Chưa phân khoa")
                                                    </span>
                                                </td>
                                                <td>@bs.namKN năm</td>
                                                <td class="fw-bold text-success">@bs.giaKham.ToString("N0") VNĐ</td>
                                                <td class="text-center">
                                                    @switch (bs.TrangThaiBS)
                                                    {
                                                        case TrangThaiBacSi.DangLamViec:
                                                            <span class="badge bg-success">Đang làm việc</span>
                                                            break;
                                                        case TrangThaiBacSi.TamNghi:
                                                            <span class="badge bg-warning text-dark">Tạm nghỉ</span>
                                                            break;
                                                        case TrangThaiBacSi.DaNghiLam:
                                                            <span class="badge bg-danger">Đã nghỉ làm</span>
                                                            break;
                                                    }
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <div class="col-lg-4">
                <div class="card border-0 shadow-sm rounded-3">
                    <div class="card-header bg-white py-3 border-0">
                        <h5 class="fw-bold mb-0 text-dark">
                            <i class="bi bi-images me-2 text-primary"></i>Cơ Sở Vật Tư MedCare
                        </h5>
                    </div>
                    <div class="card-body p-3">
                        <div class="mb-3 overflow-hidden rounded-3 shadow-sm position-relative">
                            <img src="~/images/bonk.jpg" class="img-fluid w-100"
                                 style="height: 160px; object-fit: cover;"
                                 onerror="this.src='https://via.placeholder.com/400x160?text=CHÈN+ẢNH+THIẾT+BỊ+1'" />
                            <div
                                class="position-absolute bottom-0 start-0 w-100 p-2 bg-dark bg-opacity-50 text-white small">
                                Phòng khám trang bị đạt chuẩn quốc tế
                            </div>
                        </div>

                        <div class="overflow-hidden rounded-3 shadow-sm position-relative">
                            <img src="~/images/d.jpg" class="img-fluid w-100"
                                 style="height: 160px; object-fit: cover;"
                                 onerror="this.src='https://via.placeholder.com/400x160?text=CHÈN+ẢNH+THIẾT+BỊ+2'" />
                            <div
                                class="position-absolute bottom-0 start-0 w-100 p-2 bg-dark bg-opacity-50 text-white small">
                                Đội ngũ Y Bác sĩ tận tâm chu đáo hee heeeeeeeeeeeeeeeeeee!!!! MJ gogo brbrbrbr
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
    else
    {

        <!-- BANNER CHÀO MỪNG BỆNH NHÂN -->
        <div class="card bg-success text-white mb-4 border-0 shadow-sm rounded-3 overflow-hidden">
            <div class="card-body p-4 p-lg-5">
                <div class="row align-items-center">
                    <div class="col-md-7">
                        <span class="badge bg-white text-success fw-bold px-3 py-2 mb-2 rounded-pill">
                            <i class="bi bi-heart-pulse-fill me-1"></i> Chăm Sóc Sức Khỏe Gia Đình
                        </span>
                        <h1 class="fw-bold mb-2">Chào mừng @username đến với bài tập lớn Quản Lý Phòng Khám!</h1>
                        <p class="lead mb-3 opacity-90">
                            Đặt lịch khám nhanh chóng, không lo chờ đợi. Đội ngũ bác sĩ chuyên khoa giàu kinh nghiệm luôn
                            sẵn sàng hỗ trợ bạn.
                        </p>
                        <div class="d-flex gap-2 flex-wrap">
                            <a asp-controller="DangKyKham" asp-action="Create"
                               class="btn btn-light btn-lg text-success fw-bold shadow-sm">
                                <i class="bi bi-calendar-plus me-1"></i> Đăng Ký Khám Mới
                            </a>
                            <a asp-controller="BenhNhan" asp-action="Create" class="btn btn-outline-light btn-lg fw-bold">
                                <i class="bi bi-person-plus me-1"></i> Tạo Hồ Sơ BN Mới
                            </a>
                        </div>
                    </div>

                    <!-- 📷 [CHÈN ẢNH VÀO ĐÂY] - Banner Bác sĩ khám bệnh cho Bệnh nhân -->
                    <div class="col-md-5 text-center mt-3 mt-md-0">
                        <img src="~/images/c.jpg" alt="Patient Banner" class="img-fluid rounded-3 shadow"
                             style="max-height: 200px; object-fit: cover;"
                             onerror="this.src='https://via.placeholder.com/400x200?text=CHÈN+ẢNH+BANNER+BỆNH+NHÂN'" />
                    </div>
                </div>
            </div>
        </div>

        <!-- PHÍM TẮT DỊCH VỤ DÀNH CHO BỆNH NHÂN -->
        <div class="row g-3 mb-4">
            <!-- 1. LỊCH ĐĂNG KÝ CỦA TÔI -->
            <div class="col-md-4">
                <div class="card border-0 shadow-sm h-100 text-center p-3">
                    <div class="card-body">
                        <div class="rounded-circle bg-primary bg-opacity-10 p-3 d-inline-block text-primary mb-3">
                            <i class="bi bi-calendar2-check fs-1"></i>
                        </div>
                        <h5 class="fw-bold">Lịch Đăng Ký Của Tôi</h5>
                        <p class="text-muted small">Theo dõi trạng thái các phiếu đăng ký khám bệnh đã hẹn lịch.</p>
                
                        @if (isLoggedIn)
                        {
                            <a asp-controller="DangKyKham" asp-action="Index"
                               class="btn btn-outline-primary btn-sm fw-bold px-3">
                                Xem Lịch Đã Đặt
                            </a>
                        }
                        else
                        {
                            <button type="button" class="btn btn-outline-primary btn-sm fw-bold px-3" data-bs-toggle="modal"
                                    data-bs-target="#requireLoginModal" data-feature="xem danh sách Lịch đăng ký cá nhân">
                                Xem Lịch Đã Đặt
                            </button>
                        }
                    </div>
                </div>
            </div>

            <!-- 2. HỒ SƠ BỆNH NHÂN -->
            <div class="col-md-4">
                <div class="card border-0 shadow-sm h-100 text-center p-3">
                    <div class="card-body">
                        <div class="rounded-circle bg-success bg-opacity-10 p-3 d-inline-block text-success mb-3">
                            <i class="bi bi-folder-symlink fs-1"></i>
                        </div>
                        <h5 class="fw-bold">Hồ Sơ Bệnh Nhân</h5>
                        <p class="text-muted small">Quản lý danh sách hồ sơ cá nhân và người thân đăng ký khám.</p>

                        @if (isLoggedIn)
                        {
                            <a asp-controller="BenhNhan" asp-action="Index" class="btn btn-outline-success btn-sm fw-bold px-3">
                                Quản Lý Hồ Sơ
                            </a>
                        }
                        else
                        {
                            <button type="button" class="btn btn-outline-success btn-sm fw-bold px-3" data-bs-toggle="modal"
                                    data-bs-target="#requireLoginModal" data-feature="quản lý Hồ sơ bệnh nhân">
                                Quản Lý Hồ Sơ
                            </button>
                        }
                    </div>
                </div>
            </div>

            <!-- 3. ĐỘI NGŨ BÁC SĨ -->
            <div class="col-md-4">
                <div class="card border-0 shadow-sm h-100 text-center p-3">
                    <div class="card-body">
                        <div class="rounded-circle bg-info bg-opacity-10 p-3 d-inline-block text-info mb-3">
                            <i class="bi bi-person-lines-fill fs-1"></i>
                        </div>
                        <h5 class="fw-bold">Đội Ngũ Bác Sĩ</h5>
                        <p class="text-muted small">Tham khảo danh sách các bác sĩ chuyên khoa giỏi tại phòng khám.</p>

                        @if (isLoggedIn)
                        {
                            <a asp-controller="BacSi" asp-action="Index" class="btn btn-outline-info btn-sm fw-bold px-3">
                                Tìm Bác Sĩ
                            </a>
                        }
                        else
                        {
                            <button type="button" class="btn btn-outline-info btn-sm fw-bold px-3" data-bs-toggle="modal"
                                    data-bs-target="#requireLoginModal" data-feature="tra cứu danh sách Bác sĩ">
                                Tìm Bác Sĩ
                            </button>
                        }
                    </div>
                </div>
            </div>
        </div>

        <div class="row g-4">
            <div class="col-lg-8">
                <div class="card border-0 shadow-sm rounded-3">
                    <div class="card-header bg-white py-3 border-0">
                        <h5 class="fw-bold mb-0 text-success">
                            <i class="bi bi-star-fill text-warning me-2"></i>Bác Sĩ Chuyên Khoa Tiêu Biểu
                        </h5>
                    </div>
                    <div class="card-body p-0">
                        @if (Model != null && Model.Any())
                        {
                            <div class="table-responsive">
                                <table class="table table-hover align-middle mb-0">
                                    <thead class="table-light">
                                        <tr>
                                            <th class="ps-3">Tên Bác Sĩ</th>
                                            <th>Chuyên Khoa</th>
                                            <th>Trình Độ</th>
                                            <th>Giá Khám Tham Khảo</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var bs in Model.Take(5))
                                        {
                                            <tr>
                                                <td class="ps-3 fw-bold text-dark">
                                                    <i class="bi bi-person-circle text-success me-1"></i>BS. @bs.tenBS
                                                </td>
                                                <td>
                                                    <span class="badge bg-success-subtle text-success border border-success">
                                                        @(bs.mCK?.tenCK ?? "Chuyên khoa")
                                                    </span>
                                                </td>
                                                <td>@bs.TrD</td>
                                                <td class="fw-bold text-primary">@bs.giaKham.ToString("N0") VNĐ</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <div class="col-lg-4">
                <div class="card border-0 shadow-sm rounded-3 overflow-hidden">
                    <div class="card-header bg-white py-3 border-0">
                        <h5 class="fw-bold mb-0 text-dark">
                            <i class="bi bi-newspaper me-2 text-danger"></i>Tin Tức & Ưu Đãi
                        </h5>
                    </div>
                    <div class="card-body p-3">
                        <!-- 📷 [CHÈN ẢNH VÀO ĐÂY] - Ảnh Banner Ưu đãi 1 -->
                        <div class="mb-3 position-relative overflow-hidden rounded-3 shadow-sm">
                            <img src="~/images/g.jpg" class="img-fluid w-100"
                                 style="height: 150px; object-fit: cover;"
                                 onerror="this.src='https://via.placeholder.com/400x150?text=CHÈN+ẢNH+ƯU+ĐÃI+1'" />
                            <div class="p-2 bg-light border-top">
                                <strong class="d-block text-dark small">Gói Khám Sức Khỏe Tổng Quát 2026</strong>
                                <span class="text-muted x-small">Giảm 20% chi phí đăng ký trực tuyến</span>
                            </div>
                        </div>

                        <!-- 📷 [CHÈN ẢNH VÀO ĐÂY] - Ảnh Banner Ưu đãi 2 -->
                        <div class="position-relative overflow-hidden rounded-3 shadow-sm">
                            <img src="~/images/getbacktowork.jpg" class="img-fluid w-100"
                                 style="height: 150px; object-fit: cover;"
                                 onerror="this.src='https://via.placeholder.com/400x150?text=CHÈN+ẢNH+ƯU+ĐÃI+2'" />
                            <div class="p-2 bg-light border-top">
                                <strong class="d-block text-dark small">Tư Vấn Dinh Dưỡng Cùng Bác Sĩ</strong>
                                <span class="text-muted x-small">Đặt lịch hẹn tư vấn miễn phí thứ 7 hàng tuần</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>